# demo | supabase
BASIRA_BACKEND=demo
# Generate a unique random value (32+ chars). Production rejects defaults.
BASIRA_APP_SECRET=replace-with-at-least-32-random-characters
BASIRA_DEMO_DB_PATH=.data/basira-demo.json
BASIRA_DEMO_UPLOAD_DIR=.data/uploads

# Required only when BASIRA_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upload limits
MAX_VIDEO_UPLOAD_MB=250
MAX_HANDOUT_UPLOAD_MB=25
MAX_SUBMISSION_UPLOAD_MB=20
