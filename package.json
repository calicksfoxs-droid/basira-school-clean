{
  "name": "basira-school-clean",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node --import ./scripts/legacy-brace-expansion.mjs ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "node scripts/prepare-typecheck.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "reset:demo": "node scripts/reset-demo.mjs",
    "seed:supabase": "node --env-file=.env.local scripts/seed-supabase.mjs",
    "seed:supabase:reset-admin": "node --env-file=.env.local scripts/seed-supabase.mjs --reset-admin",
    "verify:static": "node scripts/verify-release.mjs",
    "verify:release": "npm run lint && npm run typecheck && npm run test && npm run verify:static && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.25.0",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.19",
    "brace-expansion": "5.0.8",
    "sharp": "0.35.3"
  }
}
